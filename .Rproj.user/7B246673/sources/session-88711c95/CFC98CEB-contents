## Bootstrapping (Proportion of Likes vs Video Category)

```{r}
# We create this function to get a bootstrapped CI for a group
get_boot_ci <- function(likes_vector) {
  res <- boot(data = likes_vector, statistic = prop_2plus_func, R = 1000)
  ci <- boot.ci(res, type = "perc")
  return(data.frame(
    observed = res$t0,
    low = ci$percent[4],
    high = ci$percent[5]
  ))
}

# Set seed for reproducibility
set.seed(123)

# Compile the bootstrapped results across all Video Categories
category_results <- yt_data_prop %>%
  group_by(Video.Category) %>%
  summarise(stats = list(get_boot_ci(Likes)), .groups = 'drop') %>%
  tidyr::unnest(stats)

# Make a forest plot visualizing the results
ggplot(category_results, aes(x = reorder(Video.Category, observed), y = observed)) +
  geom_point(size = 3, color = "darkblue") +
  geom_errorbar(aes(ymin = low, ymax = high), width = 0.3) +
  coord_flip() +
  scale_y_continuous(labels = scales::percent) +
  labs(title = "Comparison of 2+ Like Proportions by Category (R = 1000)",
       subtitle = "Error bars represent 95% Bootstrapped Confidence Intervals",
       x = "Video Category",
       y = "Proportion of Comments with 2+ Likes") +
  theme_minimal()
```

## Logistic Regression (Proportion of Likes vs Video Category)

```{r}
# Extract the Sentiments from the dataset, using Neutral as the reference point
yt_data_prop$Sentiment <- relevel(factor(yt_data_prop$Sentiment), ref = "Neutral")

# Create a binary outcome, filtering out the low-engagement (Likes) comments
yt_data_prop$target <- ifelse(yt_data_prop$Likes >= 2, 1, 0)

# Run the model with Sentiment and Video Category as the predictors. Due to the binary structure, we use the Binomial distribution for the "family" command
model <- glm(target ~ Sentiment + Video.Category, data = yt_data_prop, family = "binomial")
summary(model)
```

