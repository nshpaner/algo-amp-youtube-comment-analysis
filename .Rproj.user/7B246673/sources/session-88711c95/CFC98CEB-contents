## Odds Ratio (Longitudinal Analysis)

```{r}
# Here, we tidy both models and add a metric label to apply it to both engagement metrics. Just like with the other models, the Log-Odds (Estimates) are converted to Odds Ratios, and the 95% CI bounds are calculated and provided
likes_or <- tidy(year_model, exponentiate = TRUE, conf.int = TRUE) %>% 
  mutate(Metric = "Likes")

replies_or <- tidy(year_model_rep, exponentiate = TRUE, conf.int = TRUE) %>% 
  mutate(Metric = "Replies")

# Combine the Odds Ratios for both mertics and filter out the Intercept (it's usually not useful for plotting)
plot_data_long <- bind_rows(likes_or, replies_or) %>%
  filter(term != "(Intercept)") %>%
  mutate(term = case_when(
    term == "Year" ~ "Year (Annual Change)",
    term == "SentimentNegative" ~ "Negative Sentiment",
    term == "SentimentPositive" ~ "Positive Sentiment",
    TRUE ~ term
  ))

# Finally, create a forest plot with the baseline OR = 1.0 to plot the results
ggplot(plot_data_long, aes(x = estimate, y = term, color = Metric)) +
  geom_vline(xintercept = 1, linetype = "dashed", color = "gray60") + 
  geom_errorbarh(aes(xmin = conf.low, xmax = conf.high), height = 0.3, size = 0.8) +
  geom_point(size = 3.5) +
  facet_wrap(~Metric, ncol = 1) +
  scale_x_log10(breaks = c(0.7, 1, 1.5, 2, 3, 4)) + # Log scale is best for ORs
  scale_color_manual(values = c("Likes" = "#2980b9", "Replies" = "#e67e22")) +
  labs(
    title = "Longitudinal Odds Ratios: News & Politics Engagement",
    subtitle = "Odds of reaching 2+ engagement threshold (Ref: Neutral Sentiment)",
    x = "Odds Ratio",
    y = "Measured Category"
  ) +
  theme_minimal() +
  theme(panel.grid.minor = element_blank(),
        strip.text = element_text(face = "bold", size = 12))
```
