## Bootstrapping (Proportion of 2+ Likes vs Sentiment)

```{r}
# Here, we are calculating the Bootstrap Proportion of 2+ Likes for Positive Sentiment. The function below is used to return the mean of high-engagement metrics
prop_2plus_func <- function(data, indices) {
  return(mean(data[indices] >= 2))
}

# We extrapolate the comments with Positive Sentiment and run a boostrap resample (R = 1000). Additionally, we set a seed for reproducibility
pos_likes_prop <- yt_data_prop$Likes[yt_data_prop$Sentiment == "Positive"]
set.seed(123)
boot_prop_pos <- boot(data = pos_likes_prop, statistic = prop_2plus_func, R = 1000)

# Now, we calculate the 95% confidence intervals (CIs) and actual value for Positive Sentiment. The results used for Figure E in the final study were derived from these values
boot_ci_results_pos <- boot.ci(boot_prop_pos, type = "perc")
ci_low_pos <- boot_ci_results_pos$percent[4]
ci_high_pos <- boot_ci_results_pos$percent[5]
actual_val_pos <- boot_prop_pos$t0
boot_df_prop_pos <- data.frame(props = boot_prop_pos$t)

# Finally, we create a histogram that visualizes the bootstrapped results for conveinence
ggplot(boot_df_prop_pos, aes(x = props)) +
  geom_histogram(bins = 30, fill = "#69b3a2", color = "white", alpha = 0.8) +
  geom_vline(xintercept = ci_low_pos, color = "red", linetype = "dashed", size = 1) +
  geom_vline(xintercept = ci_high_pos, color = "red", linetype = "dashed", size = 1) +
  geom_vline(xintercept = actual_val_pos, color = "black", size = 1.2) +
  scale_x_continuous(labels = percent_format(accuracy = 0.1)) +
  labs(title = "Bootstrap Distribution: % of Positive Comments with 2+ Likes (1000 Shuffles)",
       subtitle = "Black line = Actual Proportion | Red dashed = 95% CI",
       x = "Proportion of Comments",
       y = "Frequency",
       caption = paste0("Actual: ", round(actual_val_pos*100, 2), 
                        "%, 95% CI: [", round(ci_low_pos*100, 2), 
                        "%, ", round(ci_high_pos*100, 2), "%]")) +
  theme_minimal()
```

