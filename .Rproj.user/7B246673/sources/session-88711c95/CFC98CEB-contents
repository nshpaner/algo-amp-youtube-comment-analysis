## News and Politics (Longitudinal Analysis)

```{r}
# Filter down to News & Politics, take high-engagement comments, and summarize the results
news_trends <- yt_data %>%
  filter(Video.Category == "News & Politics") %>%
  group_by(Year) %>%
  summarise(
    Avg_Likes = mean(Likes),
    Avg_Replies = mean(Replies),
    Prop_High_Likes = mean(Likes >= 2),
    Prop_High_Replies = mean(Replies >= 2),
    Total_Comments = n(),
    .groups = 'drop'
  )

# Adjust the dataset and reshape it for plotting (Long format)
news_trends_long <- news_trends %>%
  select(Year, Prop_High_Likes, Prop_High_Replies) %>%
  pivot_longer(cols = starts_with("Prop"), 
               names_to = "Engagement_Type", 
               values_to = "Proportion") %>%
  mutate(Engagement_Type = ifelse(Engagement_Type == "Prop_High_Likes", "2+ Likes", "2+ Replies"))
