## Odds Ratio (Proportion of Likes vs Video Category)

```{r}
# Compile our Likes model results from before and clean them in preparation for visualization. The Log-Odds (Estimates) are converted to Odds Ratios, and the 95% CI bounds are calculated and provided
model_results <- tidy(model, conf.int = TRUE, exponentiate = TRUE) %>%
  filter(term != "(Intercept)") %>%
  mutate(clean_term = str_remove_all(term, "Sentiment|Video.Category") %>% str_replace_all("\\.", " "))

# Update reference data to include Neutral as the Sentiment and Autos & Vehicles as the Video Category (originally, the Sentiment was set to Negative, but this code ensures that it's Neutral instead)
reference_data <- data.frame(
  clean_term = c("Neutral", "Autos & Vehicles"), 
  estimate = c(1, 1), conf.low = c(1, 1), conf.high = c(1, 1)
)

# Bind the rows from the results and reference data to prepare for visualization
plot_data <- bind_rows(model_results, reference_data)

# Finally, create a forest plot with the baseline OR = 1.0 to plot the results
ggplot(plot_data, aes(x = reorder(clean_term, estimate), y = estimate)) +
  geom_point(size = 3, color = "#2c3e50") +
  geom_errorbar(aes(ymin = conf.low, ymax = conf.high), width = 0.4) +
  geom_hline(yintercept = 1, linetype = "dashed", color = "red", size = 0.8) +
  coord_flip() + scale_y_log10(breaks = c(0.2, 0.5, 1, 2, 5, 10)) + 
  labs(title = "Full Impact Analysis: Sentiment & Category (Likes)",
       subtitle = "Odds Ratios (Baseline = 1.0) | Neutral Sentiment is the reference point",
       x = "Predictor", y = "Odds Ratio") +
  theme_minimal()
```

